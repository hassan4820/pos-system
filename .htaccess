<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Keep Laravel and Inertia URLs rooted at /pos-system while executing the
    # real front controller from public/index.php.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Serve only public assets directly. All other paths go through Laravel.
    RewriteRule ^(build/.*|storage/.*|favicon\.ico|robots\.txt)$ public/$1 [L]
    RewriteRule ^ index.php [L]
</IfModule>
